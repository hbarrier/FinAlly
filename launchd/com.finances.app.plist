<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the production server (npm run start, port 3737) at login and restarts it
  if it stops. Build first, then install (from the repo root):

    npm run build
    sed "s|__REPO__|$PWD|g" launchd/com.finances.app.plist \
      > ~/Library/LaunchAgents/com.finances.app.plist
    launchctl load -w ~/Library/LaunchAgents/com.finances.app.plist

  Restart after a rebuild:  launchctl kickstart -k gui/$(id -u)/com.finances.app
  Stop auto-start:          launchctl unload -w ~/Library/LaunchAgents/com.finances.app.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.finances.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec npm run start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO__/.next/app.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/.next/app.log</string>
</dict>
</plist>
